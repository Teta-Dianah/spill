<mxfile host="app.diagrams.net"><diagram name="Spill deployment" id="spill-deployment"><mxGraphModel dx="2020" dy="1460" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2020" pageHeight="1460" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="userDevice" value="&lt;i&gt;«device»&lt;/i&gt;&lt;br&gt;&lt;b&gt;User's device&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#5b6470&quot;&gt;a phone or a computer&lt;/font&gt;" style="shape=cube;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;darkOpacity=0.05;darkOpacity2=0.1;size=18;flipH=1;verticalAlign=top;align=center;fillColor=#f1f5f6;strokeColor=#1e2a36;strokeWidth=2;fontSize=13;" vertex="1" parent="1"><mxGeometry x="20" y="40" width="520" height="640" as="geometry"/></mxCell><mxCell id="browser" value="&lt;i&gt;«executionEnvironment»&lt;/i&gt;&lt;br&gt;&lt;b&gt;Web browser&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#5b6470&quot;&gt;Chrome, Edge, Firefox or Safari, 320 px wide and up&lt;/font&gt;&lt;br&gt;&lt;br&gt;Runs the Spill pages for every role:&lt;br&gt;visitor, user, listener, moderator&lt;br&gt;and administrator" style="shape=cube;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;darkOpacity=0.05;darkOpacity2=0.1;size=18;flipH=1;verticalAlign=top;align=center;fillColor=#e1eff1;strokeColor=#1e2a36;strokeWidth=2;fontSize=13;" vertex="1" parent="1"><mxGeometry x="50" y="150" width="460" height="500" as="geometry"/></mxCell><mxCell id="dev" value="&lt;i&gt;«cloud»&lt;/i&gt;&lt;br&gt;&lt;b&gt;Firebase project: development (spill-dev-01)&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#5b6470&quot;&gt;Spark plan, HTTPS only. Used for all testing, including the teacher's.&lt;/font&gt;" style="shape=cube;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;darkOpacity=0.05;darkOpacity2=0.1;size=18;flipH=1;verticalAlign=top;align=center;fillColor=#f1f5f6;strokeColor=#1e2a36;strokeWidth=2;fontSize=13;" vertex="1" parent="1"><mx