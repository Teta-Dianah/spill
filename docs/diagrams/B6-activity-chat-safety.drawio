<mxCell id="report" value="Report with a reason" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#E1EFF1;strokeColor=#1F6F78;strokeWidth=2;fontSize=13;fontFamily=Helvetica;fontColor=#1F2A37;" vertex="1" parent="1"><mxGeometry x="100" y="1265" width="240" height="56" as="geometry"/></mxCell>
