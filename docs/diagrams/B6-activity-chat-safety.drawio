<mxCell id="close" value="Close the chat" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#E1EFF1;strokeColor=#1F6F78;strokeWidth=2;fontSize=13;fontFamily=Helvetica;fontColor=#1F2A37;" vertex="1" parent="1"><mxGeometry x="730" y="925" width="300" height="56" as="geometry"/></mxCell>
<mxCell id="after" value="User only: give a mood after (needed to end), then answer &quot;Was this chat helpful?&quot; and &quot;Would you use Spill again?&quot; if they like" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#E1EFF1;strokeColor=#1F6F78;strokeWidth=2;fontSize=13;fontFamily=Helvetica;fontColor=#1F2A37;" vertex="1" parent="1"><mxGeometry x="60" y="900" width="320" height="110" as="geometry"/></mxCell>
<mxCell id="copy" value="Save the anonymised copy (chatStats)" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#E1EFF1;strokeColor=#1F6F78;strokeWidth=2;fontSize=13;fontFamily=Helvetica;fontColor=#1F2A37;" vertex="1" parent="1"><mxGeometry x="730" y="1040" width="300" height="56" as="geometry"/></mxCell>
