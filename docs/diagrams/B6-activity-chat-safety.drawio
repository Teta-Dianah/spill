<mxCell id="queue" value="Open the queue: most serious first, then oldest" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#E1EFF1;strokeColor=#1F6F78;strokeWidth=2;fontSize=13;fontFamily=Helvetica;fontColor=#1F2A37;" vertex="1" parent="1"><mxGeometry x="1380" y="1261" width="300" height="64" as="geometry"/></mxCell>
