<mxCell id="c1a" value="Not sent (the Rules refuse it too). The sender is warned." style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#E1EFF1;strokeColor=#1F6F78;strokeWidth=2;fontSize=13;fontFamily=Helvetica;fontColor=#1F2A37;" vertex="1" parent="1"><mxGeometry x="450" y="440" width="200" height="80" as="geometry"/></mxCell>
<mxCell id="c1b" value="Save a blocked-attempt flag: severity 2, or 3 for a listener" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#E1EFF1;strokeColor=#1F6F78;strokeWidth=2;fontSize=13;fontFamily=Helvetica;fontColor=#1F2A37;" vertex="1" parent="1"><mxGeometry x="450" y="545" width="200" height="80" as="geometry"/></mxCell>
<mxCell id="c2a" value="Save the message and a crisis flag (severity 3) in one write. The Rules refuse one without the other." style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#E1EFF1;strokeColor=#1F6F78;strokeWidth=2;fontSize=13;fontFamily=Helvetica;fontColor=#1F2A37;" vertex="1" parent="1"><mxGeometry x="670" y="440" width="200" height="100" as="geometry"/></mxCell>
<mxCell id="c2b" value="Show the sender the crisis card" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#E1EFF1;strokeColor=#1F6F78;strokeWidth=2;fontSize=13;fontFamily=Helvetica;fontColor=#1F2A37;" vertex="1" parent="1"><mxGeometry x="670" y="565" width="200" height="60" as="geometry"/></mxCell>
